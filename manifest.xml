<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
           xmlns:bt="http://schemas.microsoft.com/office/appforoffice/1.1/basictypes" 
           xmlns:ov="http://schemas.microsoft.com/office/appforoffice/1.0/versionOverrides" 
           xsi:type="TaskPaneApp">
  
  <Id>b2a82910-4811-49b8-9363-22100a120011</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>213tau</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SVG Vector Injector"/>
  <Description DefaultValue="Paste and inject raw SVG vector shapes into PowerPoint slides."/>
  
  <Icon DefaultValue="https://powerpoint-svg-add-in.vercel.app/icon-32.png"/>
  <SupportUrl DefaultValue="https://github.com/213tau/powerpoint-svg-add-in"/>
  
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  
  <DefaultSettings>
    <SourceLocation DefaultValue="https://powerpoint-svg-add-in.vercel.app/"/>
  </DefaultSettings>
  
  <Permissions>ReadWriteDocument</Permissions>

  <!-- Desktop Ribbon & UI Overrides -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpanearapp/v1.0" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="SvgInjectorTab">
              <Label resid="TabLabel"/>
              <Group id="SvgInjectorGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon16"/>
                  <bt:Image size="32" resid="Icon32"/>
                  <bt:Image size="80" resid="Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="OpenTaskpaneButton">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonTitle"/>
                    <Description resid="ButtonDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>SvgInjectorTaskPane</TaskpaneId>
                    <SourceLocation DefaultValue="https://powerpoint-svg-add-in.vercel.app/"/>
                  </Action>
                </Control>
              </Group>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://powerpoint-svg-add-in.vercel.app/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://powerpoint-svg-add-in.vercel.app/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://powerpoint-svg-add-in.vercel.app/icon-80.png"/>
      </bt:Images>
      <bt:Strings>
        <bt:String id="TabLabel" DefaultValue="Vector Tools"/>
        <bt:String id="GroupLabel" DefaultValue="SVG"/>
        <bt:String id="ButtonLabel" DefaultValue="Open SVG Injector"/>
        <bt:String id="ButtonTitle" DefaultValue="SVG Vector Injector"/>
        <bt:String id="ButtonDesc" DefaultValue="Open panel to inject raw SVG vectors into slides."/>
      </bt:Strings>
    </Resources>
  </VersionOverrides>
</OfficeApp>